    U3 --> OWNER
    U5 --> OWNER
    
    R5 --> ADMIN
    B5 --> ADMIN
    I6 --> ADMIN
    T6 --> ADMIN
    M3 --> ADMIN
    U4 --> ADMIN

    %% Request/Response Flow Examples
    subgraph "Common API Flows"
        FLOW1[Customer Places Order:<br/>1. POST /api/order<br/>2. Webhook payment confirmation<br/>3. GET /api/order/-id- for status]
        FLOW2[Manager Processes Kitchen:<br/>1. GET /api/kitchen/queues/-branchId-<br/>2. POST /api/order/check-prepared<br/>3. WebSocket updates]
        FLOW3[Table Reservation:<br/>1. GET /api/table/available/-branchId-<br/>2. POST /api/table/reserve<br/>3. PUT /api/table/free/-id-]
    end

    %% Styling
    classDef publicEndpoint fill:#e8f5e8,stroke:#4caf50
    classDef userEndpoint fill:#e3f2fd,stroke:#2196f3
    classDef managerEndpoint fill:#fff3e0,stroke:#ff9800
    classDef ownerEndpoint fill:#fce4ec,stroke:#e91e63
    classDef adminEndpoint fill:#f3e5f5,stroke:#9c27b0
    classDef httpMethod fill:#f5f5f5,stroke:#757575
    classDef authLevel fill:#fff8e1,stroke:#ffa000

    class CA1,CA2,CA3,W1,W2,W3 publicEndpoint
    class CA4,CA5,CA6,R1,R2,I1,I8,T1,T7,T9,T10,T11,T12,O1,O3,O4,O6,O10 userEndpoint
    class B1,B2,M1,I2,T2,T8,O2,O5,O7,O8,O9,K1,K2,K3,K4,K5,K6,K7,Q1,Q2,Q3,Q4,Q5,Q6,Q7 managerEndpoint
    class R3,R4,R6,B3,B4,I3,I4,I5,I7,T3,T4,T5,M2,M4,U1,U2,U3,U5 ownerEndpoint
    class R5,B5,I6,T6,M3,U4 adminEndpoint
    class GET,POST,PUT,DELETE httpMethod
    class PUBLIC,USER,MANAGER,OWNER,ADMIN authLevel
