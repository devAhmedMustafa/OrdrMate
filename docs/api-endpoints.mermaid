    Q4 --> MANAGER
    Q5 --> MANAGER
    Q6 --> MANAGER
    Q7 --> MANAGER
    
    R3 --> OWNER
    R4 --> OWNER
    R6 --> OWNER
    B3 --> OWNER
    B4 --> OWNER
    I3 --> OWNER
    I4 --> OWNER
    I5 --> OWNER
    I7 --> OWNER
    T3 --> OWNER
    T4 --> OWNER
    T5 --> OWNER
    M2 --> OWNER
    M4 --> OWNER
    U1 --> OWNER
