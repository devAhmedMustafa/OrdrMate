    T1 --> USER
    T7 --> USER
    T9 --> USER
    T10 --> USER
    T11 --> USER
    T12 --> USER
    O1 --> USER
    O3 --> USER
    O4 --> USER
    O6 --> USER
    O10 --> USER
    
    B1 --> MANAGER
    B2 --> MANAGER
    M1 --> MANAGER
    I2 --> MANAGER
    T2 --> MANAGER
    T8 --> MANAGER
    O2 --> MANAGER
    O5 --> MANAGER
    O7 --> MANAGER
    O8 --> MANAGER
    O9 --> MANAGER
