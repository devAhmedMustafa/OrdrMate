---
title: OrdrMate REST API Endpoints Documentation
config:
  theme: default
---
graph LR
    subgraph "Authentication Endpoints"
        subgraph "Customer Auth - /api/customer"
            CA1[POST /register<br/>RegisterUserDto]
            CA2[POST /login<br/>LoginDto]
            CA3[POST /google-login<br/>GoogleTokenDto]
            CA4[POST /refresh-token<br/>RefreshTokenDto]
            CA5[PUT /upgrade-role<br/>UpgradeRoleDto]
            CA6[GET /profile<br/>Get Current User]
        end
    end

    subgraph "Restaurant Management"
        subgraph "Restaurant - /api/restaurant"
            R1[GET /<br/>Get All Restaurants]
            R2[GET /-id-<br/>Get Restaurant Details]
            R3[POST /<br/>CreateRestaurantDto]
            R4[PUT /-id-<br/>UpdateRestaurantDto]
            R5[DELETE /-id-<br/>Delete Restaurant]
            R6[GET /user/-userId-<br/>Get User Restaurants]
        end
        
        subgraph "Branch - /api/branch"
            B1[GET /restaurant/-restaurantId-<br/>Get Restaurant Branches]
            B2[GET /-id-<br/>Get Branch Details]
            B3[POST /<br/>CreateBranchDto]
            B4[PUT /-id-<br/>UpdateBranchDto]
            B5[DELETE /-id-<br/>Delete Branch]
            B6[GET /manager/-managerId-<br/>Get Manager Branches]
        end
        
        subgraph "Manager - /api/manager"
            M1[GET /branch/-branchId-<br/>Get Branch Managers]
            M2[POST /assign<br/>AssignManagerDto]
            M3[DELETE /remove/-managerId-/-branchId-<br/>Remove Manager]
            M4[PUT /permissions<br/>UpdatePermissionsDto]
        end
    end

    subgraph "Menu Management"
        subgraph "Items - /api/item"
            I1[GET /restaurant/-restaurantId-<br/>Get Restaurant Items]
            I2[GET /branch/-branchId-<br/>Get Branch Items]
            I3[GET /-id-<br/>Get Item Details]
            I4[POST /<br/>CreateItemDto]
            I5[PUT /-id-<br/>UpdateItemDto]
            I6[DELETE /-id-<br/>Delete Item]
            I7[PUT /-id-/availability<br/>UpdateAvailabilityDto]
            I8[GET /category/-category-<br/>Get Items by Category]
        end
    end

    subgraph "Table Management"
        subgraph "Tables - /api/table"
            T1[GET /restaurant/-restaurantId-<br/>Get Restaurant Tables]
            T2[GET /branch/-branchId-<br/>Get Branch Tables]
            T3[GET /-id-<br/>Get Table Details]
            T4[POST /<br/>CreateTableDto]
            T5[PUT /-id-<br/>UpdateTableDto]
            T6[DELETE /-id-<br/>Delete Table]
            T7[POST /reserve<br/>ReserveTableDto]
            T8[PUT /free/-id-<br/>Free Table]
            T9[GET /available/-branchId-<br/>Get Available Tables]
            T10[POST /join-queue<br/>JoinQueueDto]
            T11[GET /queue-status/-customerId-<br/>Get Queue Status]
            T12[DELETE /leave-queue/-queueId-<br/>Leave Queue]
        end
    end

    subgraph "Order Processing"
        subgraph "Orders - /api/order"
            O1[GET /customer/-customerId-<br/>Get Customer Orders]
            O2[GET /branch/-branchId-<br/>Get Branch Orders]
            O3[GET /-id-<br/>Get Order Details]
            O4[POST /<br/>PlaceOrderDto]
            O5[PUT /-id-/status<br/>UpdateOrderStatusDto]
            O6[PUT /pick/-id-<br/>Pick Order]
            O7[GET /item_queues/-branchId-<br/>Get Kitchen Queues]
            O8[POST /check-prepared/-branchId-/-kitchen-/-unit-<br/>Mark Item Prepared]
            O9[GET /analytics/-branchId-<br/>Get Order Analytics]
            O10[PUT /cancel/-id-<br/>Cancel Order]
        end
    end

    subgraph "Kitchen Operations"
        subgraph "Kitchen - /api/kitchen"
            K1[GET /branch/-branchId-<br/>Get Kitchen Status]
            K2[PUT /-id-/status<br/>UpdateKitchenStatusDto]
            K3[GET /queues/-branchId-<br/>Get All Kitchen Queues]
            K4[POST /item/-itemId-/start<br/>Start Item Preparation]
            K5[POST /item/-itemId-/complete<br/>Complete Item]
            K6[GET /performance/-branchId-<br/>Get Performance Metrics]
            K7[PUT /capacity/-branchId-<br/>Update Kitchen Capacity]
        end
    end

    subgraph "Queue Management"
        subgraph "Queues - /api/queues"
            Q1[GET /branch/-branchId-<br/>Get All Branch Queues]
            Q2[GET /order/-branchId-<br/>Get Order Queues]
            Q3[GET /table/-branchId-<br/>Get Table Queues]
            Q4[GET /kitchen/-branchId-<br/>Get Kitchen Queues]
            Q5[PUT /priority/-customerId-<br/>Move to Priority]
            Q6[GET /analytics/-branchId-<br/>Get Queue Analytics]
            Q7[PUT /optimize/-branchId-<br/>Optimize Queues]
        end
    end

    subgraph "File Management"
        subgraph "Upload - /api/upload"
            U1[POST /image<br/>Upload Image File]
            U2[POST /document<br/>Upload Document]
            U3[GET /file/-fileName-<br/>Get File URL]
            U4[DELETE /file/-fileName-<br/>Delete File]
            U5[POST /bulk<br/>Upload Multiple Files]
        end
    end

    subgraph "Payment Integration"
        subgraph "Webhook - /webhook/paymob"
            W1[POST /<br/>Payment Confirmation]
            W2[POST /transaction<br/>Transaction Update]
            W3[POST /refund<br/>Refund Notification]
        end
    end

    %% HTTP Methods and Status Codes
    subgraph "HTTP Methods & Responses"
        GET[GET Requests<br/>200 OK, 404 Not Found]
        POST[POST Requests<br/>201 Created, 400 Bad Request]
        PUT[PUT Requests<br/>200 OK, 404 Not Found]
        DELETE[DELETE Requests<br/>204 No Content, 404 Not Found]
    end

    %% Authentication Requirements
    subgraph "Authorization Levels"
        PUBLIC[🌐 Public Access]
        USER[🔐 Authenticated User]
        MANAGER[👔 Branch Manager]
        OWNER[👑 Restaurant Owner]
        ADMIN[⚡ System Admin]
    end

    %% Endpoint Authorization Mapping
    CA1 --> PUBLIC
    CA2 --> PUBLIC
    CA3 --> PUBLIC
    W1 --> PUBLIC
    W2 --> PUBLIC
    W3 --> PUBLIC
    
    CA4 --> USER
    CA5 --> USER
    CA6 --> USER
